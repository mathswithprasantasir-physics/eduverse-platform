{
  "name": "eduverse-platform",
  "version": "1.0.0",
  "description": "Complete educational platform for WBBSE/WBCHSE/ISC/ICSE/CBSE boards",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "nodemon server/server.js",
    "client": "npm start --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix client",
    "build:full": "npm install && cd client && npm install && npm run build",
    "postinstall": "cd client && npm install"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "multer": "^1.4.5-lts.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.10.0",
    "axios": "^1.3.5",
    "react-markdown": "^8.0.7",
    "remark-math": "^5.1.1",
    "rehype-katex": "^6.0.3",
    "katex": "^0.16.4",
    "react-syntax-highlighter": "^15.5.0",
    "react-icons": "^4.8.0",
    "fuse.js": "^6.6.2"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "concurrently": "^8.0.1",
    "@vitejs/plugin-react": "^4.0.0",
    "vite": "^4.2.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}